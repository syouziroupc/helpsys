<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>HelpSys</AssemblyName>
    <RootNamespace>HelpSys</RootNamespace>
    <DefineConstants>$(DefineConstants);HELPSYS_OUTLAW_BUILD</DefineConstants>
    <Version>3.1.6</Version>
    <AssemblyVersion>3.1.6.0</AssemblyVersion>
    <FileVersion>3.1.6.0</FileVersion>
    <Product>HelpSys Outlaw</Product>
    <Description>HelpSys Outlaw operation-first Windows guidance</Description>
    <HelpSysBuildId Condition="'$(HelpSysBuildId)' == ''">dev</HelpSysBuildId>
    <InformationalVersion>3.1.6-outlaw+$(HelpSysBuildId)</InformationalVersion>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
    <OptimizationPreference>Speed</OptimizationPreference>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TestBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);HELPSYS_TEST_BUILD</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="HelpSysBuildId" Value="$(HelpSysBuildId)" />
    <AssemblyMetadata Include="HelpSysUpdateChannel" Value="outlaw-latest" />
    <Compile Include="..\Shared\CloudAiAdapter.cs" Link="Shared\CloudAiAdapter.cs" />
    <PackageReference Include="NAudio" Version="3.0.1" />
    <PackageReference Include="System.Speech" Version="10.0.11" />
  </ItemGroup>
</Project>
