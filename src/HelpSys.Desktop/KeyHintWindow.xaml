<Window x:Class="HelpSys.KeyHintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" Height="170"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent">
  <Border Margin="8" Padding="18" CornerRadius="18" Background="#FFFFFFFF" BorderBrush="#28000000" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.25" />
    </Border.Effect>
    <StackPanel>
      <TextBlock Text="キーボードでこのキーを押してください" FontSize="14" FontWeight="SemiBold" Foreground="#FF1B2436" HorizontalAlignment="Center" />
      <Border Margin="0,12,0,10" Padding="12,8" CornerRadius="10" Background="#FFF3F6FA" BorderBrush="#FFD5DCE7" BorderThickness="1" HorizontalAlignment="Center">
        <TextBlock x:Name="KeysText" FontFamily="Consolas" FontSize="27" FontWeight="Bold" Foreground="#FF10213D" TextAlignment="Center" />
      </Border>
      <TextBlock x:Name="InstructionText" FontSize="15" Foreground="#FF27334A" TextAlignment="Center" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</Window>
