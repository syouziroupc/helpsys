<Window x:Class="HelpSys.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        SizeToContent="WidthAndHeight">
  <Grid IsHitTestVisible="False" Margin="8">
    <Border BorderBrush="#FF0067C0" BorderThickness="4" CornerRadius="8" Background="#080067C0" Padding="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="ArrowText" Text="↓" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#FF0067C0" />
        <Border Grid.Row="1" Background="#F2FFFFFF" CornerRadius="6" Padding="10,6" Margin="0,4,0,0">
          <TextBlock x:Name="InstructionText" Text="ここを左クリック" FontSize="16" FontWeight="SemiBold" Foreground="#FF111111" MaxWidth="360" TextWrapping="Wrap" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
