<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HelpSys.Stable</AssemblyName>
    <RootNamespace>HelpSys.Stable</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>3.0.3</Version>
    <AssemblyVersion>3.0.3.0</AssemblyVersion>
    <FileVersion>3.0.3.0</FileVersion>
    <InformationalVersion>A3.0001-stable+$(HelpSysBuildId)</InformationalVersion>
    <HelpSysBuildId Condition="'$(HelpSysBuildId)' == ''">dev</HelpSysBuildId>
    <HelpSysDisplayVersion>A3.0001</HelpSysDisplayVersion>
    <HelpSysReleaseNumber>1</HelpSysReleaseNumber>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Speech" Version="10.0.12" />
    <AssemblyMetadata Include="HelpSysBuildId" Value="$(HelpSysBuildId)" />
    <AssemblyMetadata Include="HelpSysUpdateChannel" Value="preview-latest" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>HelpSys.Stable.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
