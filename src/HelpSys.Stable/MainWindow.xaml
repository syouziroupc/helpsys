<Window x:Class="HelpSys.Stable.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelpSys Stable 3.0.0 — Gemini Edition"
        Width="600"
        Height="390"
        MinWidth="520"
        MinHeight="350"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="HelpSys Stable 3.0.0"
                 FontSize="25"
                 FontWeight="Bold" />
      <TextBlock Margin="0,5,0,0"
                 Foreground="#FF4B5563"
                 Text="Gemini Edition / Gemini 3.8 Flash専用 / 1画面・1判定・1操作案内" />
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,20,0,0">
      <TextBlock Text="やりたいこと" FontWeight="SemiBold" />
      <TextBox x:Name="GoalBox"
               Margin="0,7,0,0"
               Height="68"
               Padding="10,8"
               FontSize="16"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto"
               Text="メモ帳を開きたい" />
    </StackPanel>

    <Border Grid.Row="2"
            Margin="0,18,0,0"
            Padding="12"
            Background="#FFF3F4F6"
            CornerRadius="8">
      <TextBlock x:Name="StatusText"
                 Text="待機中。操作したい画面を前面に出して F8 を押してください。"
                 TextWrapping="Wrap"
                 VerticalAlignment="Center" />
    </Border>

    <Grid Grid.Row="3" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Button x:Name="VoiceButton"
              Grid.Column="0"
              Width="100"
              Height="34"
              Margin="0,0,10,0"
              Content="音声入力"
              Click="VoiceButton_Click" />

      <CheckBox x:Name="SpeakCheckBox"
                Grid.Column="1"
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                IsChecked="True"
                Content="案内を読み上げ" />

      <Button x:Name="UpdateButton"
              Grid.Column="2"
              Width="100"
              Height="34"
              Content="更新確認"
              Click="UpdateButton_Click" />

      <TextBlock Grid.Column="3"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Center"
                 Foreground="#FF6B7280"
                 Text="F8 = 案内開始" />
    </Grid>

    <Grid Grid.Row="4" Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0"
                 VerticalAlignment="Center"
                 Foreground="#FF6B7280"
                 Text="操作はHelpSysが実行せず、利用者が行います。" />

      <Button x:Name="CancelButton"
              Grid.Column="1"
              Width="90"
              Height="38"
              Margin="0,0,10,0"
              Content="中止"
              Click="CancelButton_Click" />

      <Button x:Name="GuideButton"
              Grid.Column="2"
              Width="135"
              Height="38"
              FontWeight="SemiBold"
              Content="案内する  F8"
              Click="GuideButton_Click" />
    </Grid>
  </Grid>
</Window>
