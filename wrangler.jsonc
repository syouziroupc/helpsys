{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "helpsys",
  "main": "worker/gemini-primary.js",
  "compatibility_date": "2026-09-08",
  "cache": {
    "enabled": false
  },
  "assets": {
    "directory": "./site"
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "HELPSYS_GEMINI_MODEL": "gemini-3.8-flash",
    "HELPSYS_MODEL": "@cf/zai-org/glm-4.7-flash",
    "HELPSYS_VISION_MODEL": "@cf/zai-org/glm-5.3-flash",
    "HELPSYS_QUALITY_MODEL": "@cf/zai-org/glm-5.3-flash",
    "HELPSYS_ASR_MODEL": "@cf/openai/whisper-large-v3-turbo"
  }
}
