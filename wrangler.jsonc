{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "helpsys",
  "main": "worker/reliability-v4-guard.js",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./site"
  },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "GUIDE_RATE_LIMITER",
      "namespace_id": "26090901",
      "simple": {
        "limit": 80,
        "period": 60
      }
    },
    {
      "name": "ASR_RATE_LIMITER",
      "namespace_id": "26090902",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "EDUCATION_RATE_LIMITER",
      "namespace_id": "26090903",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "vars": {
    "HELPSYS_MODEL": "@cf/zai-org/glm-4.7-flash",
    "HELPSYS_VISION_MODEL": "@cf/zai-org/glm-5.3-flash",
    "HELPSYS_QUALITY_MODEL": "@cf/zai-org/glm-5.3-flash",
    "HELPSYS_ASR_MODEL": "@cf/openai/whisper-large-v3-turbo"
  }
}
