{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "helpsys",
  "main": "worker/reliability-v4-guard.js",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./site"
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "HELPSYS_MODEL": "@cf/zai-org/glm-4.7-flash",
    "HELPSYS_VISION_MODEL": "@cf/zai-org/glm-5.3-flash",
    "HELPSYS_QUALITY_MODEL": "@cf/zai-org/glm-5.3-flash"
  }
}
